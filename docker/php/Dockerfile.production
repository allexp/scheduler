FROM node:22-alpine AS frontend

WORKDIR /build

COPY src/package.json src/package-lock.json ./
RUN npm ci

COPY src/resources ./resources
COPY src/vite.config.js ./vite.config.js
RUN npm run build

FROM composer:2 AS vendor

WORKDIR /build

COPY src ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --ignore-platform-req=ext-sockets \
    --prefer-dist \
    --optimize-autoloader

FROM ubuntu:24.04 AS app

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        software-properties-common \
    && add-apt-repository -y ppa:ondrej/php \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        php8.4-cli \
        php8.4-fpm \
        php8.4-amqp \
        php8.4-bcmath \
        php8.4-curl \
        php8.4-gd \
        php8.4-intl \
        php8.4-mbstring \
        php8.4-opcache \
        php8.4-pgsql \
        php8.4-redis \
        php8.4-xml \
        php8.4-zip \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's|listen = /run/php/php8.4-fpm.sock|listen = 9000|' /etc/php/8.4/fpm/pool.d/www.conf \
    && sed -i 's|;clear_env = no|clear_env = no|' /etc/php/8.4/fpm/pool.d/www.conf \
    && mkdir -p /run/php /var/www/html

WORKDIR /var/www/html

COPY src ./
COPY --from=vendor /build/vendor ./vendor
COPY --from=frontend /build/public/build ./public/build

RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R ug+rwX storage bootstrap/cache

EXPOSE 9000

CMD ["/usr/sbin/php-fpm8.4", "-F"]

FROM nginx:1.27-alpine AS nginx

COPY docker/nginx/production.conf /etc/nginx/conf.d/default.conf
COPY src/public /var/www/html/public
COPY --from=frontend /build/public/build /var/www/html/public/build
