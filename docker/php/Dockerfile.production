FROM node:22-alpine AS frontend

WORKDIR /build

COPY src/package.json src/package-lock.json ./
RUN npm ci

COPY src/resources ./resources
COPY src/vite.config.js ./vite.config.js
RUN npm run build

FROM composer:2 AS vendor

WORKDIR /build

COPY src ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --ignore-platform-req=ext-sockets \
    --prefer-dist \
    --optimize-autoloader

FROM ubuntu:24.04 AS app

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        php-cli \
        php-fpm \
        php-amqp \
        php-bcmath \
        php-curl \
        php-gd \
        php-intl \
        php-mbstring \
        php-opcache \
        php-pgsql \
        php-redis \
        php-xml \
        php-zip \
    && rm -rf /var/lib/apt/lists/* \
    && sed -i 's|listen = /run/php/php8.3-fpm.sock|listen = 9000|' /etc/php/8.3/fpm/pool.d/www.conf \
    && sed -i 's|;clear_env = no|clear_env = no|' /etc/php/8.3/fpm/pool.d/www.conf \
    && mkdir -p /run/php /var/www/html

WORKDIR /var/www/html

COPY src ./
COPY --from=vendor /build/vendor ./vendor
COPY --from=frontend /build/public/build ./public/build

RUN chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R ug+rwX storage bootstrap/cache

EXPOSE 9000

CMD ["/usr/sbin/php-fpm8.3", "-F"]

FROM nginx:1.27-alpine AS nginx

COPY docker/nginx/production.conf /etc/nginx/conf.d/default.conf
COPY src/public /var/www/html/public
COPY --from=frontend /build/public/build /var/www/html/public/build
